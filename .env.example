# Copy this file to .env and change the values. Never commit .env.

# Core
NODE_ENV=development
NODE_DB_ENV=development
PORT=5000
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# JWT. JWT_TTL is the token life in seconds (3600 = 1 hour). Use a long random secret.
JWT_BEARER_SECRET="change-this-to-a-long-random-text"
JWT_TTL=3600

# Database (PostgreSQL)
DB_CLIENT="postgres"
DB_HOST="localhost"
DB_PORT="5432"
DB_DATABASE="gaari_bhara"
DB_USER="gaari"
DB_PASSWORD="gaari_dev_password"

# Email (optional). Leave MAILER_HOST empty to only write emails in the log.
# For a real test use a Mailtrap sandbox (https://mailtrap.io).
MAILER_HOST=
MAILER_PORT=2525
MAILER_SECURE=false
MAILER_USER=
MAILER_PASSWORD=
MAILER_FROM="Gaari Bhara <no-reply@gaaribhara.test>"
